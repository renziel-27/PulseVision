# PulseVision Environment Configuration Example
# Copy to .env and adjust variables as needed

# Application Settings
PROJECT_NAME="PulseVision AI Heart Monitoring & Health Assessment System"
VERSION="2.0-Research"
PORT=8000
HOST="127.0.0.1"

# Security & Authentication
PULSEVISION_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to SQLite in backend/pulsevision.db)
DATABASE_URL="sqlite:///backend/pulsevision.db"

# Optional Twilio SMS Integration (Leave blank to use internal SQLite audit logger)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Real SMTP Email Configuration (e.g. Gmail App Password, AWS SES, SendGrid, custom SMTP)
# Leave blank if email service is not yet configured
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_EMAIL=""
SMTP_PASSWORD=""
SMTP_FROM="PulseVision AI Health <noreply@pulsevision.ai>"

# WhatsApp Business / Cloud API Configuration (Meta Graph API)
# Leave blank if WhatsApp Cloud API is not yet configured
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
